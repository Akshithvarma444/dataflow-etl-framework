# Secrets
.env
.env.*
!.env.example
kaggle.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Licensed or bulky data: downloaded from source, never redistributed here.
# data/samples/ (small synthetic samples) and data/expected/ are committed.
data/raw/**
data/generated/**
data/processed/**
data/rejected/**
!data/**/.gitkeep

# Runtime output. reports/ is committed on purpose as execution evidence.
logs/**
!logs/.gitkeep

# Local tooling, unrelated to this project
.sf/
.claude/
.vscode/
.idea/
