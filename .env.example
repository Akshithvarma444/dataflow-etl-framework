# Copy to .env and set a real password. .env is gitignored; never commit it.

POSTGRES_USER=dataflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dataflow
# Dedicated database for automated tests; tests never touch POSTGRES_DB.
POSTGRES_TEST_DB=dataflow_test

# Used by a pipeline running on the host. The pipeline container overrides both
# (host "db", port 5432), see docker-compose.yml. 5434 avoids clashing with a
# PostgreSQL already running locally on the usual ports. Use 127.0.0.1, not
# localhost: the port is published on IPv4 only, and localhost may try IPv6 first
# and stall before falling back.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# Optional overrides for config/settings.yaml.
# DATAFLOW_BATCH_SIZE=50000
# DATAFLOW_LOG_LEVEL=INFO
